{
  "extends": ["next/core-web-vitals"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@/lib/supabase/admin",
            "message": "Service-role client is server-only. Use lib/supabase/server.ts instead."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["lib/supabase/admin.ts", "lib/admin/**/*.ts", "lib/notifications/**/*.ts", "lib/contracts/**/*.ts", "lib/prices/**/*.ts", "scripts/**/*.ts", "actions/**/*.ts", "app/api/**/*.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
