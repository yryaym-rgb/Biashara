# Supabase — URL du projet (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase — clé anonyme publique (sûre côté navigateur ; le RLS applique les droits d'accès)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — clé service role (SERVEUR UNIQUEMENT — ne jamais exposer au client ni en NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# URL de base de l'application (redirections d'authentification et liens e-mail)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Locale par défaut (fr = URLs propres en français, en = préfixe /en)
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# API metals.dev pour les cotations spot — côté serveur uniquement
METALS_API_URL=https://api.metals.dev/v1/latest
METALS_API_KEY=

# Script de création d'administrateur (scripts/create-admin.ts) — local/dev uniquement
ADMIN_EMAIL=admin@biashara.cd
ADMIN_PASSWORD=

# Porte d'accès administration (segment d'URL secret + phrase de passe)
ADMIN_GATE_SECRET=
ADMIN_PASSPHRASE=

# URL de base pour les tests e2e Playwright (optionnel)
PLAYWRIGHT_BASE_URL=http://localhost:3000
