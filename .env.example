# Supabase — project URL (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase — public anon key (safe for browser; RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role key (SERVER ONLY — never expose to client or NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Application base URL (used for auth redirects and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default locale (fr = French clean URLs, en = /en prefix)
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# metals.dev spot price API — server-side only
METALS_API_URL=https://api.metals.dev/v1/latest
METALS_API_KEY=

# Admin bootstrap script (scripts/create-admin.ts) — local/dev only
ADMIN_EMAIL=admin@biashara.cd
ADMIN_PASSWORD=

# Playwright e2e base URL (optional)
PLAYWRIGHT_BASE_URL=http://localhost:3000
