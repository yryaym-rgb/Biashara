{
  "name": "biashara",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=guest --project=setup",
    "test:e2e:prod": "npm run build && PLAYWRIGHT_SERVER_MODE=production playwright test",
    "test:e2e:dev": "PLAYWRIGHT_SERVER_MODE=dev playwright test",
    "setup:e2e-fixtures": "tsx scripts/setup-e2e-fixtures.ts",
    "types:gen": "supabase gen types typescript --local > types/database.types.ts && echo 'Regenerated types/database.types.ts from local Supabase. Review diff before committing.'",
    "create-admin": "tsx scripts/create-admin.ts",
    "map:generate": "tsx scripts/generate-drc-map-paths.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.62.8",
    "lucide-react": "^0.469.0",
    "next": "^14.2.21",
    "next-intl": "^3.26.2",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@netlify/plugin-nextjs": "^5.9.2",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "d3-geo": "^3.1.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.21",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
